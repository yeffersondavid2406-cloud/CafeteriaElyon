generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  CLIENTE
  ADMIN
  EMPLEADO
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  telefono  String?
  rol       Rol      @default(CLIENTE)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos   Pedido[]

  @@map("usuarios")
}

model Categoria {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  productos   Producto[]

  @@map("categorias")
}

model Producto {
  id          Int       @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Decimal   @db.Decimal(10, 2)
  imagen      String?
  categoriaId Int
  stock       Int       @default(0)
  destacado   Boolean   @default(false)
  disponible  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  inventario  Inventario?
  detalles    DetallePedido[]

  @@map("productos")
}

model Inventario {
  id          Int      @id @default(autoincrement())
  productoId  Int      @unique
  cantidad    Int      @default(0)
  stockMinimo Int      @default(5)
  updatedAt   DateTime @updatedAt
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("inventarios")
}

model Pedido {
  id          Int            @id @default(autoincrement())
  usuarioId   Int
  mesa        Int?
  subtotal    Decimal        @db.Decimal(10, 2)
  descuento   Decimal        @default(0) @db.Decimal(10, 2)
  total       Decimal        @db.Decimal(10, 2)
  metodoPago  MetodoPago
  estado      EstadoPedido   @default(PENDIENTE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  usuario     Usuario        @relation(fields: [usuarioId], references: [id])
  detalles    DetallePedido[]

  @@map("pedidos")
}

model DetallePedido {
  id        Int      @id @default(autoincrement())
  pedidoId  Int
  productoId Int
  cantidad  Int
  precio    Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto  Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@map("detalles_pedido")
}

model Promocion {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  descuento   Decimal  @db.Decimal(10, 2)
  fechaInicio DateTime @db.Timestamp(3)
  fechaFin    DateTime @db.Timestamp(3)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("promociones")
}